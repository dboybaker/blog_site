/public/
/resources/_gen/
/.hugo_build.lock
.DS_Store
/tools/
/assets/data/[0-9]*/
# Raw benchmark run caches next to the articles (large; Hugo ignores them for
# publishing, but this keeps them out of git too).
/content/blog/*/results/

# Working material that backs an article but is never published: raw run output,
# generated app trees, scratch notes. Kept on disk for reference only - it lives
# outside content/ so Hugo never assembles it, and out of git so it never ships.
/_offline/

# data/ is Hugo's site-data dir, and a fresh benchmark run unpacked next to an
# article lands here - tens of megabytes of evalscope cache that Hugo would
# happily parse into .Site.Data and `git add -A` would happily commit. Only the
# small *_results.json files that feed the article shortcodes belong in git
# (data/blog/<article>/), so allow just those back in; the raw runs, scratch
# notes and generated app trees stay in _offline/ (above), and the published
# images/SVG/PDF live in the article bundle under content/.
/data/**
!/data/blog/
!/data/blog/*/
!/data/blog/*/*_results.json
